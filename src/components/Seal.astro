---
// Rotating guilloché seal — a security-print rosette in the brand gold.
// Decorative only (aria-hidden); the licence badge text is real copy nearby.
import Mark from './Mark.astro';

const ringText =
  'FGFC MARKETS GLOBAL LTD · A LICENSED INVESTMENT FIRM · FGFC MARKETS GLOBAL LTD · A LICENSED INVESTMENT FIRM · ';
const petals = Array.from({ length: 24 }, (_, i) => i * 15);
---

<svg class="seal" viewBox="0 0 300 300" aria-hidden="true" role="presentation">
  <defs>
    <path
      id="seal-text-path"
      d="M150,150 m-118,0 a118,118 0 1,1 236,0 a118,118 0 1,1 -236,0"
    ></path>
  </defs>

  <!-- outer engraved rings -->
  <g class="spin-slow">
    <circle cx="150" cy="150" r="146" stroke="currentColor" stroke-opacity="0.35" stroke-width="1" stroke-dasharray="2 6" fill="none"></circle>
    <circle cx="150" cy="150" r="138" stroke="currentColor" stroke-opacity="0.22" stroke-width="1" fill="none"></circle>
    <circle cx="150" cy="150" r="134" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.4" stroke-dasharray="16 9" fill="none"></circle>
  </g>

  <!-- rotating circular inscription -->
  <g class="spin-rev">
    <text
      font-size="11.5"
      letter-spacing="3.2"
      fill="currentColor"
      fill-opacity="0.88"
      style="font-family: 'Marcellus', serif;"
    >
      <textPath href="#seal-text-path">{ringText}</textPath>
    </text>
  </g>

  <circle cx="150" cy="150" r="102" stroke="currentColor" stroke-opacity="0.4" stroke-width="1" fill="none"></circle>

  <!-- guilloché rosette -->
  <g class="spin-slow" stroke="currentColor" stroke-opacity="0.16" fill="none" stroke-width="0.8">
    {petals.map((deg) => (
      <ellipse
        cx="150"
        cy="150"
        rx="92"
        ry="34"
        transform={`rotate(${deg} 150 150)`}
      ></ellipse>
    ))}
  </g>

  <circle cx="150" cy="150" r="58" stroke="currentColor" stroke-opacity="0.34" stroke-width="1" stroke-dasharray="1.5 4" fill="none"></circle>

  <!-- centre mark -->
  <g transform="translate(108 111) scale(0.37) translate(-666 0)" color="currentColor">
    <Mark />
  </g>
</svg>
