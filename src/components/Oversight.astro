---
import Seal from './Seal.astro';

// Clause 1 (incorporation / company number) was removed at legal review as a
// duplicate, and the investor-compensation clause was removed as inapplicable
// to a Mauritius investment firm.
const clauses = [
  'The company’s operations follow the framework of the Financial Services Commission (FSC) of Mauritius, a framework built around disclosure obligations, fair-dealing rules and safeguards for client interests.',
  'FGFC Markets Global Ltd is subject to ongoing regulatory reporting and prudential requirements under the applicable FSC framework.',
  'Headquartered in Mauritius, the company is permitted to offer services across multiple jurisdictions.',
];
---

<section id="oversight" class="sec sec-oversight" aria-labelledby="oversight-title">
  <img
    class="oversight-tex"
    src="/assets/guilloche.webp"
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
  />

  <div class="shell oversight-grid">
    <div data-reveal-group>
      <div class="sec-head">
        <p class="overline" data-reveal><span aria-hidden="true">III</span><span class="sr-only">Section three</span></p>
        <p class="tagline" data-reveal>
          A license is not decoration. It is the mechanism that keeps a firm accountable.
        </p>
        <h2 class="sec-title" id="oversight-title" data-reveal>Oversight</h2>
      </div>

      <ol class="clauses">
        {clauses.map((clause) => (
          <li data-reveal>
            <p>{clause}</p>
          </li>
        ))}
      </ol>

      <div class="oversight-cta" data-reveal>
        <a class="btn" href="#reach-us">Reach Us <span class="btn-arr" aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="seal-col" data-reveal>
      <Seal />
      <p class="badge-line">A Licensed<br />Investment Firm</p>
    </div>
  </div>
</section>
