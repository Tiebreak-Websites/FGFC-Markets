---
import { tok } from '../lib/tokens.mjs';

// The [Risk Disclosure] bracket in the copy deck is a document link,
// not a pending-data token — it points at the risk-disclosure page.
const riskBody1 = tok(
  'FGFC Markets Global Ltd (“the Company”) holds a [LICENSE TYPE], license number [LICENSE NUMBER], under supervision of [REGULATOR FULL NAME] in [JURISDICTION]. Contracts for Differences (“CFDs”) are leveraged instruments and carry substantial risk of capital loss; price movements can erode a position quickly, and in some jurisdictions losses may exceed the funds deposited. CFDs will not suit every investor. Before opening an account, satisfy yourself that you understand how these instruments behave, weigh whether your financial circumstances can absorb this level of risk, and consult an independent adviser where needed. Commit only funds you can afford to lose in full. Historical results carry no weight in predicting future outcomes, and no projection issued by the company should be read as a guarantee.'
);
---

<footer id="site-footer">
  <div class="shell">
    <div class="risk-head">
      <h2>Risk Notice</h2>
      <span class="rule" data-reveal></span>
    </div>

    <div class="risk-body">
      <p set:html={riskBody1} />
      <p>
        Nothing on this website should be read as an offer or invitation to residents of a
        jurisdiction where such an offer would be unauthorised.
      </p>
      <p set:html={tok('This website belongs to FGFC Markets Global Ltd, [FULL REGISTERED ADDRESS].')} />
      <p>
        Full details are available in our <a href="/risk-disclosure">Risk Disclosure</a> document.
      </p>
    </div>

    <div class="foot-bottom">
      <p class="foot-copy" set:html={tok('© [YEAR] FGFC Markets Global Ltd. All rights reserved.')} />

      <nav class="foot-links" aria-label="Legal">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Use</a>
        <a href="/cookies">Cookie Notice</a>
      </nav>

      <a class="to-top" href="#overview">
        <span class="tt-arr" aria-hidden="true">↑</span> Back to top
      </a>
    </div>
  </div>
</footer>
