---
// Entry III previously cited a years-of-experience and regions-served claim,
// removed at legal review (the company was established in 2025) and restated as
// a procedural fact rather than an experience claim.
const entries = [
  {
    no: 'I',
    title: 'Execution',
    body: 'Execution technology that holds up under load.',
  },
  {
    no: 'II',
    title: 'Transparent Pricing',
    body: 'Pricing that stays visible before and after a trade.',
  },
  {
    no: 'III',
    title: 'Service Standard',
    body:
      'One set of execution and disclosure procedures, applied to every account regardless of size or turnover.',
  },
];
---

<section id="what-we-offer" class="sec sec-offer" aria-labelledby="offer-title">
  <div class="shell">
    <div class="sec-head" data-reveal-group>
      <p class="overline" data-reveal><span aria-hidden="true">IV</span><span class="sr-only">Section four</span></p>
      <p class="tagline" data-reveal>
        Access to a market is worth little without the infrastructure to act on it.
      </p>
      <h2 class="sec-title" id="offer-title" data-reveal>What We Offer</h2>
    </div>

    <div class="offer-grid">
      <div data-reveal-group>
        <p class="offer-intro" data-reveal>
          FGFC Markets Global Ltd gives traders a route into global markets through CFDs
          covering Commodities, Currencies, ETFs, Indices, and Stocks.
        </p>
        <p class="offer-anchor-note" data-reveal>Three things anchor the offering —</p>
      </div>

      <div data-reveal-group>
        <ol class="ledger">
          {entries.map(({ no, title, body }) => (
            <li data-reveal>
              <span class="entry-no" aria-hidden="true">{no}</span>
              <div>
                <h3>{title}</h3>
                <p>{body}</p>
              </div>
            </li>
          ))}
        </ol>

        <p class="offer-close body-copy" data-reveal>
          FGFC Markets Global Ltd is subject to the regulatory requirements applicable to
          its Investment Dealer Licence.
        </p>
      </div>
    </div>
  </div>
</section>
