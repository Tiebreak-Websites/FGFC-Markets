---
// Slow tape of the site's section taglines — pure atmosphere, duplicated
// once so the CSS translateX(-50%) loop is seamless. Hidden from AT.
// Two earlier lines were removed at legal review; keep this list in step with
// the taglines in Oversight.astro / Offer.astro / ReachUs.astro.
const lines = [
  'A license is not decoration. It is the mechanism that keeps a firm accountable.',
  'Access to a market is worth little without the infrastructure to act on it.',
  'Plenty of things about markets are complicated. Reaching us isn’t one of them.',
];
---

<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    {[0, 1].map(() => (
      <div class="ticker-item">
        {lines.map((line) => (
          <>
            <span>{line}</span>
            <span class="tick-sep">◆</span>
          </>
        ))}
      </div>
    ))}
  </div>
</div>
