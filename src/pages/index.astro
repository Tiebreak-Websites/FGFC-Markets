---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Rail from '../components/Rail.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import WhoWeAre from '../components/WhoWeAre.astro';
import Oversight from '../components/Oversight.astro';
import Offer from '../components/Offer.astro';
import ReachUs from '../components/ReachUs.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="FGFC Markets Global Ltd — A Licensed Investment Firm"
  description="FGFC Markets Global Ltd is an investment firm licensed and regulated by the Financial Services Commission (FSC) of Mauritius as an Investment Dealer, providing online trading access to Contracts for Difference (CFDs)."
>
  <Header />
  <Rail />

  <main id="main-content">
    <Hero />
    <Ticker />
    <WhoWeAre />
    <Oversight />
    <Offer />
    <ReachUs />
  </main>

  <Footer />
</Base>
